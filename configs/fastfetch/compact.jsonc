{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "38;2;38;166;154",
      "2": "38;2;128;222;234"
    },
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "keys": "38;2;38;166;154",
      "title": "38;2;128;222;234",
      "separator": "38;2;84;110;122"
    },
    "key": {
      "type": "icon",
      "width": 2
    }
  },
  "modules": [
    "title",
    {
      "type": "os",
      "keyIcon": "󰣇",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "keyIcon": ""
    },
    {
      "type": "uptime",
      "keyIcon": ""
    },
    {
      "type": "packages",
      "keyIcon": "󰏖"
    },
    {
      "type": "de",
      "keyIcon": ""
    },
    {
      "type": "cpu",
      "keyIcon": "",
      "format": "{name}"
    },
    {
      "type": "memory",
      "keyIcon": ""
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
