{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch3",
    "color": {
      "1": "38;2;26;188;156",
      "2": "38;2;128;222;234",
      "3": "38;2;38;166;154"
    },
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰑃 ",
    "color": {
      "keys": "cyan",
      "title": "cyan",
      "output": "",
      "separator": "cyan"
    },
    "key": {
      "type": "icon",
      "width": 3
    },
    "percent": {
      "type": ["num", "num-color"],
      "color": {
        "green": "32",
        "yellow": "93",
        "red": "91"
      }
    }
  },
  "modules": [
    {
      "type": "os",
      "keyIcon": "󰣇",
      "format": "{2} {8}"
    },
    {
      "type": "host",
      "keyIcon": "󰌢",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "keyIcon": "",
      "format": "{sysname} {release}"
    },
    {
      "type": "uptime",
      "keyIcon": ""
    },
    {
      "type": "packages",
      "keyIcon": "󰏖"
    },
    {
      "type": "shell",
      "keyIcon": ""
    },
    {
      "type": "display",
      "keyIcon": "󰍹",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "de",
      "keyIcon": ""
    },
    {
      "type": "wm",
      "keyIcon": ""
    },
    {
      "type": "theme",
      "keyIcon": "󰉼",
      "format": "{1}"
    },
    {
      "type": "icons",
      "keyIcon": "󰀻",
      "format": "{1}"
    },
    {
      "type": "cursor",
      "keyIcon": "󰆿",
      "format": "{1} ({2}px)"
    },
    {
      "type": "terminal",
      "keyIcon": ""
    },
    {
      "type": "cpu",
      "keyIcon": "",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "keyIcon": "󰾲",
      "format": "{name:18} [{type}]"
    },
    {
      "type": "memory",
      "keyIcon": ""
    },
    {
      "type": "swap",
      "keyIcon": "󰓡"
    },
    {
      "type": "disk",
      "keyIcon": "󰋊",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "keyIcon": "",
      "symbol": "circle"
    }
  ]
}
